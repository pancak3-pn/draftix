{
  "name": "draftix-react",
  "version": "1.1.1",
  "private": true,
  "description": "Real-time Valorant map & agent draft tool. No signup. Just draft.",
  "homepage": "https://draftix.tech",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "dev:react": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build --configLoader runner",
    "preview": "vite preview",
    "video:studio": "remotion studio remotion/index.jsx",
    "video:render": "remotion render remotion/index.jsx DraftixTutorial out/draftix-tutorial.mp4",
    "sync:agents": "node scripts/sync-valorant-agents.mjs",
    "test": "node test/test-resume.js && node test/test-draft-ops.js",
    "test:supabase": "node scripts/supabase-smoke.js"
  },
  "keywords": [
    "valorant",
    "draft",
    "esports",
    "veto",
    "real-time",
    "socket.io"
  ],
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.520",
    "@vitejs/plugin-react": "^5.0.2",
    "remotion": "^4.0.520",
    "socket.io-client": "^4.8.3",
    "vite": "^7.1.3"
  }
}
